{
  "name": "draftroom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.json && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src server shared tests scripts research/library.json community/library.json *.ts *.json *.yaml README.md",
    "format:check": "prettier --check src server shared tests scripts research/library.json community/library.json *.ts *.json *.yaml README.md",
    "research": "tsx scripts/research.ts",
    "community": "tsx scripts/community.ts",
    "capture:draft": "node scripts/capture-live-draft.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "cheerio": "^1.2.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.0.3"
  }
}
